# Copy to .env and fill in your values

# Broker
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# AI / Sentiment
# ANTHROPIC_API_KEY=

# News
# NEWS_API_KEY=

# Earnings calendar (universe filter — free tier at finnhub.io)
# FINNHUB_API_KEY=

# Risk parameters
# MAX_POSITION_SIZE_PCT=0.08
# MAX_OPEN_POSITIONS=5
# MAX_DAILY_LOSS_PCT=0.03
# MAX_DRAWDOWN_PCT=0.08
# KELLY_FRACTION=0.25
# MIN_EDGE_PCT=0.04
# MAX_HOLD_DAYS=5
