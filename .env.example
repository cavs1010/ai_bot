# =============================================================================
# AI Trading Bot Cockpit — Environment Configuration
# =============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# Broker API: Alpaca Markets (Paper or Live)
# -----------------------------------------------------------------------------
# Get your API keys at: https://app.alpaca.markets/
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Paper Trading Base URL (Default): https://paper-api.alpaca.markets
# Live Trading Base URL: https://api.alpaca.markets
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# -----------------------------------------------------------------------------
# AI & Large Language Model (Gate 3 & Gate 4 Intelligence)
# -----------------------------------------------------------------------------
# Google Gemini API Key (Recommended): https://aistudio.google.com/
GEMINI_API_KEY=

# Optional LLM Fallbacks
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Financial & Market Data APIs (Optional / Enhanced Feeds)
# -----------------------------------------------------------------------------
FINNHUB_API_KEY=
POLYGON_API_KEY=
NEWS_API_KEY=
