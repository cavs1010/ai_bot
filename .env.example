# Copy to .env and fill in your values

# Broker
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# AI / Sentiment
# ANTHROPIC_API_KEY=

# News
# NEWS_API_KEY=

# Earnings calendar (universe filter — free tier at finnhub.io)
# FINNHUB_API_KEY=

# Strategy dials (universe filter, momentum scanner, gate thresholds, EV, position
# size, Phase 5 risk gate — MAX_OPEN_POSITIONS, MAX_DAILY_LOSS_PCT, MAX_DRAWDOWN_PCT,
# KELLY_FRACTION, etc.) are NOT here — they live on the documented board: backend/config.py.
# .env is only for secrets / API keys.

